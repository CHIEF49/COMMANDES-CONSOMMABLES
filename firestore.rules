rules_version = '2';

// Accès par mot de passe : seul le compte de l'équipe (equipe@consommables-e2efa.app),
// connecté avec le mot de passe partagé, peut lire et modifier la liste.
// Seule la collection « commandes » est accessible, et chaque fiche doit avoir une forme valide.
service cloud.firestore {
  match /databases/{database}/documents {
    match /commandes/{id} {
      allow read, delete: if equipe();
      allow create, update: if equipe() && valide(request.resource.data);
    }

    function equipe() {
      return request.auth != null && request.auth.token.email == 'equipe@consommables-e2efa.app';
    }

    function valide(d) {
      return d.keys().hasOnly(['name', 'device', 'reference', 'quantity', 'status', 'urgent', 'note'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 200
        && d.status in ['catalogue', 'a_commander']
        && (!('quantity' in d) || (d.quantity is int && d.quantity >= 1 && d.quantity <= 9999))
        && (!('device' in d) || (d.device is string && d.device.size() <= 60))
        && (!('reference' in d) || (d.reference is string && d.reference.size() <= 80))
        && (!('note' in d) || (d.note is string && d.note.size() <= 1000))
        && (!('urgent' in d) || d.urgent is bool);
    }
  }
}
